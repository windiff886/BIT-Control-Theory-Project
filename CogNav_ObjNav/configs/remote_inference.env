# CogNav 远程推理配置文件
# 使用方法: source configs/remote_inference.env

# ============================================================
# 模式选择
# ============================================================

# OpenSeeD 远程推理 (Colab)
# 1 = 使用 Colab 远程推理, 0 = 本地加载模型
export USE_REMOTE_OPENSEED=1

# LLM 远程推理 (CogVLM2 on Colab)
# 1 = 使用 CogVLM2 (Colab), 0 = 使用 Qwen API
export USE_REMOTE_INFERENCE=0

# ============================================================
# OpenSeeD 远程服务配置 (Colab)
# ============================================================

# OpenSeeD API 地址 (从 Colab 获取的 ngrok 地址)
export OPENSEED_API_URL="https://phylogenetic-fertile-tajuana.ngrok-free.dev"

# ============================================================
# Qwen API 配置 (当 USE_REMOTE_INFERENCE=0 时使用)
# ============================================================

# Qwen API Key (必填 - 替换为你的密钥)
export QWEN_API_KEY="sk-xxxxxx"

# Qwen API 地址 (阿里云)
export INFERENCE_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 视觉模型 (用于图像理解: 房间识别、目标确认)
export QWEN_MODEL="qwen-vl-max"

# 文本模型 (用于推理: 状态转换、节点选择)
export QWEN_TEXT_MODEL="qwen-plus"

# ============================================================
# CogVLM2 远程服务配置 (当 USE_REMOTE_INFERENCE=1 时使用)
# ============================================================

# CogVLM2 API 地址 (从 Colab 获取的 ngrok 地址)
export LLM_API_URL="https://your-cogvlm-ngrok-url.ngrok-free.dev"

# ============================================================
# 使用说明
# ============================================================
#
# 推荐配置 (OpenSeeD Colab + Qwen API):
#   1. 在 Colab 运行 OpenSeeD 服务，获取 ngrok 地址
#   2. 修改 OPENSEED_API_URL 为你的 ngrok 地址
#   3. 在 https://dashscope.console.aliyun.com/ 获取 Qwen API Key
#   4. 修改 QWEN_API_KEY
#   5. 运行: source configs/remote_inference.env
#   6. 运行: python main.py --scenes TEEsavR23oF
#
# ============================================================
